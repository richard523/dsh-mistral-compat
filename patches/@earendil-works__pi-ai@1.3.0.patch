+/**
+ * Normalize one streamed `delta.content` value into text and thinking strings.
+ * OpenAI sends a plain string; Mistral-style OpenAI-compatible servers send
+ * content chunks such as `{ type: "thinking", thinking: [{ type: "text", text }] }`
+ * and `{ type: "text", text }`. Concatenating those chunks directly stringifies
+ * them ("[object Object]") and hands downstream consumers a non-string delta.
+ */
+function contentDeltaParts(content) {
+    if (typeof content === "string") {
+        return { text: content, thinking: "" };
+    }
+    let text = "";
+    let thinking = "";
+    if (Array.isArray(content)) {
+        for (const part of content) {
+            if (!part || typeof part !== "object")
+                continue;
+            if (part.type === "text" && typeof part.text === "string") {
+                text += part.text;
+            }
+            else if (part.type === "thinking" && Array.isArray(part.thinking)) {
+                for (const chunk of part.thinking) {
+                    if (chunk && typeof chunk.text === "string") {
+                        thinking += chunk.text;
+                    }
+                }
+            }
+        }
+    }
+    return { text, thinking };
+}
