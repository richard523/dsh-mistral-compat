{
  "name": "@deepseek-ai/node-addon-system-workspace",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm build:ts",
    "build:ts": "tsc -b",
    "build:native": "bun ./scripts/build.ts",
    "build:test-oracle": "bun ./scripts/build-test-oracle.mjs",
    "typecheck": "tsc --noEmit && tsc -b --dry",
    "test": "bun ./test/entry.test.js && bun ./test/launcher.test.js && bun test ./test/flock.test.js ./test/package-matrix.test.js ./test/release-packing.test.js",
    "test:entry": "bun ./test/entry.test.js",
    "test:launcher": "bun ./test/launcher.test.js",
    "test:flock": "bun test ./test/flock.test.js",
    "test:packaging": "bun test ./test/package-matrix.test.js ./test/release-packing.test.js",
    "gha:matrix": "bun ./scripts/github-matrix.mjs",
    "release:bump": "bun ./scripts/bump-release.mjs",
    "release:commit": "bun ./scripts/commit-release.mjs",
    "release:assemble-prebuilds": "bun ./scripts/assemble-prebuilds.mjs",
    "release:verify": "bun ./scripts/verify-release.mjs",
    "release:pack": "bun ./scripts/pack-release.mjs",
    "release:publish": "bun ./scripts/publish-release.mjs",
    "release:verify-packed-install": "bun ./scripts/verify-packed-install.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
